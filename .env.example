# Client-side (Vite) settings. These are PUBLIC values: the publishable/anon key is safe to ship to browsers.
# Never put a service_role key, KIPRIS key or any AI provider key here — those live in Edge Function Secrets
# (supabase secrets set KIPRIS_API_KEY=… LOVABLE_API_KEY=… ADMIN_PASSWORD=…).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Kept for tooling that reads the non-prefixed names (same values as above).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
